//######################################################################################################
// PLC 04 : Safety PLC
//######################################################################################################


#define cDistX_Limit		-623000		// Ws-Vs Distance, Small -> Narrow

global gWs_Error_Cur2 = 0;	// 260325 추가
global gWs_Error_Old2 = 0;
global gVs_Error_Cur2 = 0;
global gVs_Error_Old2 = 0;
open plc 4
//-------------------------------------------------------------//
// Safety Alarm
//-------------------------------------------------------------//
	// Ethercat Disconnction Detect
	if(gEc_Con_Ena==0)
	{
		if(gEc_Com_Sta(0)==cEcComSta_Ng)
		{
			gEc_WdTimer++;
		}
		else
		{
			gEc_WdTimer = 0;
		}

		if(gEc_WdTimer > cTimeOut_Ecat)
		{
			gEc_WdTimer = 0;
			gEc_Con_Start = 1;
		}
	}

	if(gEc_Com_Sta(0)==cEcComSta_Ng)
	{
		gWs_Safety_Err = cErrCode_EtEtherCat;
		gWs_Safety_Err = cErrCode_EtEtherCat;
		gWs_Safety_Sta = cSafetySta_Err;
		gVs_Safety_Sta = cSafetySta_Err;
	}
	else
	{
		// Stage Crash Detect
		// 오른쪽 스테이지(nwX) 원점 기준으로, 왼쪽 스테이지(nvX) 원점이 얼마나 더 왼쪽(+)에 있는지 거리
		// 추후 파라미터 값으로 작업 예정.... 
		local OriginOffset = 0.0;
		switch(cMachineID)
		{
		case 1:
			OriginOffset = -1562414; //OriginOffset = (nwX_ActPos+Homoffset + 230) - (nvX\_ActPos+Homeoffset - 190) // 3Line
			break;
		case 2:
			OriginOffset = -1245243; //OriginOffset = (nwX_ActPos+Homoffset + 230) - (nvX\_ActPos+Homeoffset - 190) // 1Line
			break;
		case 3:
			OriginOffset = -1246101; //OriginOffset = (nwX_ActPos+Homoffset + 230) - (nvX\_ActPos+Homeoffset - 190) // 2Line
			break;
		default:
		break;
		}
		
		// 각 스테이지 원점에서 마주보는 끝단(센서/도그 끝)까지의 돌출 거리 (mm)
		local nvX_HalfSize = 190;  // 왼쪽 스테이지(nvX)의 우측 끝단(센서) 돌출량
		local nwX_HalfSize = 230;  // 오른쪽 스테이지(nwX)의 좌측 끝단(도그) 돌출량

		local AccelTime = 0.1;      // 가감속 시간 (sec)
		local RespTime = 0.05;      // 시스템 반응 시간 (sec)
		local SafetyMargin = 20.0;  // 기구적 여유 간격 (mm)

		local V_nvX, V_nwX, P_nvX_Abs, P_nwX_Abs;
		local nvX_RightEdge, nwX_LeftEdge, RealGap, gMc_SafeDist;
		local StopD_nvX, StopD_nwX;

		if(Motor[nwX].HomeComplete==1 && Motor[nvX].HomeComplete==1)
		{
			V_nvX = abs(Motor[nvX].ActVel * 1000); 
			V_nwX = abs(Motor[nwX].ActVel * 1000); 

			P_nwX_Abs = Motor[nwX].ActPos + Motor[nwX].HomePos;
			P_nvX_Abs = (Motor[nvX].ActPos + Motor[nvX].HomePos) + OriginOffset;

			nvX_RightEdge = P_nvX_Abs - nvX_HalfSize; 
			nwX_LeftEdge  = P_nwX_Abs + nwX_HalfSize; 

			RealGap = nvX_RightEdge - nwX_LeftEdge;
			gMc_DistX_Cur = RealGap;

			StopD_nvX = (V_nvX * AccelTime / 2.0) + (V_nvX * RespTime);
			StopD_nwX = (V_nwX * AccelTime / 2.0) + (V_nwX * RespTime);
			gMc_SafeDist = StopD_nvX + StopD_nwX + SafetyMargin;

			if (RealGap < gMc_SafeDist)
			{
				gMc_DistX_Err = 1;
			}
			else
			{
				gMc_DistX_Err = 0;
			}

			if(gMc_DistX_Err == 1)
			{
				Motor[nvX].MinPos = Motor[nvX].DesPos - Motor[nvX].HomePos;
				Motor[nvX].MaxPos = Motor[nvX].MinPos + 5000000; // 왼쪽(+) 대피는 허용
        
				Motor[nwX].MaxPos = Motor[nwX].DesPos - Motor[nwX].HomePos;
				Motor[nwX].MinPos = Motor[nwX].MaxPos - 5000000; // 오른쪽(-) 대피는 허용
        
				gWs_Safety_Sta = cSafetySta_Err;
				gVs_Safety_Sta = cSafetySta_Err;
				gWs_Safety_Err = cErrCode_EtCrash;
				gVs_Safety_Err = cErrCode_EtCrash;

				if(gMc_AutoRun_Ena==1 || gWs_Loop_Ena==1 || gVs_Loop_Ena==1)
				{
					gMc_AutoRun_Abort = 1;
				}
			}
			else
			{
				Motor[nwX].MaxPos = 0;
				Motor[nwX].MinPos = 0;
				Motor[nvX].MaxPos = 0;
				Motor[nvX].MinPos = 0;
			}
		}
		else
		{
			gMc_DistX_Err = 0;
		}
	}

	// Scanner Error
	if(gMach_Type==0)
	{
		gSc_Com_Sta = cScComSta_Ok;
	}
	else if((Gate3[1].Chan[0].SerialEncDataB & $FF000000) != $78000000 || (Gate3[1].Chan[1].SerialEncDataB & $FF000000) != $78000000)
	{
		gSc_Com_Sta = cScComSta_Ng;
		gWs_Safety_Err = cErrCode_EtScServo;
		gWs_Safety_Sta = cSafetySta_Err;
	}//20251230 KJH - Vision Stage는 Scanner와 상관 없는 것으로 생각 되어 Welding 쪽으로 변경.
//	else if((Gate3[1].Chan[1].SerialEncDataB & $FF000000) != $78000000)
//	{
//		gSc_Com_Sta = cScComSta_Ng;
//		gVs_Safety_Err = cErrCode_EtScServo;
//		gVs_Safety_Sta = cSafetySta_Err;
//	}
	else
	{
		gSc_Com_Sta = cScComSta_Ok;
	}


//-------------------------------------------------------------//
// Alarm Set
//-------------------------------------------------------------//
	// Sequence Error
	if(gWs_Load_Sta==cSeqSta_Err)		gWs_Seq_Err |= cErrFlg_Ld;
	if(gWs_Ready_Sta==cSeqSta_Err)		gWs_Seq_Err |= cErrFlg_Rd;
	if(gWs_Welding_Sta==cSeqSta_Err)	gWs_Seq_Err |= cErrFlg_Wd;
	if(gWs_Wait_Sta==cSeqSta_Err)		gWs_Seq_Err |= cErrFlg_Wt;
	if(gWs_Unload_Sta==cSeqSta_Err)		gWs_Seq_Err |= cErrFlg_Ud;
	if(gWs_Reject_Sta==cSeqSta_Err)		gWs_Seq_Err |= cErrFlg_Rj;

	if(gVs_Load_Sta==cSeqSta_Err)		gVs_Seq_Err |= cErrFlg_Ld;
	if(gVs_Ready_Sta==cSeqSta_Err)		gVs_Seq_Err |= cErrFlg_Rd;
	if(gVs_Vision_Sta==cSeqSta_Err)		gVs_Seq_Err |= cErrFlg_Vn;
	if(gVs_Wait_Sta==cSeqSta_Err)		gVs_Seq_Err |= cErrFlg_Wt;
	if(gVs_Unload_Sta==cSeqSta_Err)		gVs_Seq_Err |= cErrFlg_Ud;
	if(gVs_Reject_Sta==cSeqSta_Err)		gVs_Seq_Err |= cErrFlg_Rj;


	// Ws Alarm Update
	if(gWs_Safety_Sta==cSafetySta_Err)
	{
		gWs_ErrCode	= gWs_Safety_Err;
		gWs_Error = 1;
	}
	else if(gWs_Home_Sta==cHomeSta_Err)
	{
		gWs_ErrCode = gWs_Home_Err;
		gWs_Error = 1;
	}
	else if(gMc_Home_Sta==cHomeSta_Err)
	{
		gWs_ErrCode = gMc_Home_Err;
		gWs_Error = 1;
	}
	else if(gMc_AutoRun_Sta==cSeqSta_Err)
	{
		gWs_ErrCode = gMc_AutoRun_Err;
		gWs_Error = 1;
	}
	else if(gWs_Seq_Err!=0)
	{
		if(gWs_Load_Sta==cSeqSta_Err)			gWs_ErrCode = gWs_Load_Err;
		else if(gWs_Ready_Sta==cSeqSta_Err)		gWs_ErrCode = gWs_Ready_Err;
		else if(gWs_Welding_Sta==cSeqSta_Err)	gWs_ErrCode = gWs_Welding_Err;
		else if(gWs_Wait_Sta==cSeqSta_Err)		gWs_ErrCode = gWs_Wait_Err;
		else if(gWs_Unload_Sta==cSeqSta_Err)	gWs_ErrCode = gWs_Unload_Err;
		else if(gWs_Reject_Sta==cSeqSta_Err)	gWs_ErrCode = gWs_Reject_Err;
		gWs_Error = 1;
	}
	else if(gWs_Loop_Sta==cSeqSta_Err)
	{
		gWs_ErrCode = gWs_Loop_Err;
		gWs_Error = 1;
	}
	else
	{
		gWs_Error = 0;
	}

	// Vs Alarm Update
	if(gVs_Safety_Sta==cSafetySta_Err)
	{
		gVs_ErrCode	= gVs_Safety_Err;
		gVs_Error = 1;
	}
	else if(gVs_Home_Sta==cHomeSta_Err)
	{
		gVs_ErrCode = gVs_Home_Err;
		gVs_Error = 1;
	}
	else if(gVs_Seq_Err!=0)
	{
		if(gVs_Load_Sta==cSeqSta_Err)			gVs_ErrCode = gVs_Load_Err;
		else if(gVs_Ready_Sta==cSeqSta_Err)		gVs_ErrCode = gVs_Ready_Err;
		else if(gVs_Vision_Sta==cSeqSta_Err)	gVs_ErrCode = gVs_Vision_Err;
		else if(gVs_Wait_Sta==cSeqSta_Err)		gVs_ErrCode = gVs_Wait_Err;
		else if(gVs_Unload_Sta==cSeqSta_Err)	gVs_ErrCode = gVs_Unload_Err;
		else if(gVs_Reject_Sta==cSeqSta_Err)	gVs_ErrCode = gVs_Reject_Err;
		gVs_Error = 1;
	}
	else if(gVs_Loop_Sta==cSeqSta_Err)
	{
		gVs_ErrCode = gVs_Loop_Err;
		gVs_Error = 1;
	}
	else
	{
		gVs_Error = 0;
	}

	///////////////////////////////////////////////////////	// 260325 추가
	gWs_Error_Cur2 = gWs_Error;
	if(gWs_Error_Cur2==1 && gWs_Error_Old2==0)
	{
		call spSetSeqBufQ(cEffSta_WsErr,0,0,0,0);		
	}
	else if(gWs_Error_Cur2==0 && gWs_Error_Old2==1)
	{
		call spSetSeqBufQ(cEffSta_WsIdl,0,0,0,0);		
	}
	gWs_Error_Old2 = gWs_Error_Cur2;

	gVs_Error_Cur2 = gVs_Error;
	if(gVs_Error_Cur2==1 && gVs_Error_Old2==0)
	{
		call spSetSeqBufQ(cEffSta_VsErr,0,0,0,0);		
	}
	else if(gVs_Error_Cur2==0 && gVs_Error_Old2==1)
	{
		call spSetSeqBufQ(cEffSta_VsIdl,0,0,0,0);		
	}
	gVs_Error_Old2 = gVs_Error_Cur2;
	///////////////////////////////////////////////////////

//-------------------------------------------------------------//
// Alarm Reset
//-------------------------------------------------------------//
	if(gMc_AlarmReset_Ena==1)
	{
		gMc_AlarmReset_Ena = 0;
		gWs_AlarmReset_Ena = 1;
		gVs_AlarmReset_Ena = 1;
	}

	if(gWs_AlarmReset_Ena==1)
	{
		gWs_AlarmReset_Ena = 0;
		call spResetWsAlarm();
	}

	if(gVs_AlarmReset_Ena==1)
	{
		gVs_AlarmReset_Ena = 0;
		pUmem_Cmd_Vs_AlarmReset = 0;
		call spResetVsAlarm();
	}

	if(gSc_AlarmReset_Ena==1)
	{
		gSc_AlarmReset_Ena = 0;

		if(gSc_Home_Sta==cHomeSta_Err)			gSc_Home_Sta	  = cHomeSta_Idl;
		if(gMt_Home_Sta(nsX)==cHomeSta_Err)		gMt_Home_Sta(nsX) = cHomeSta_Idl;
		if(gMt_Home_Sta(nsY)==cHomeSta_Err)		gMt_Home_Sta(nsY) = cHomeSta_Idl;
	}

	if(gWs_AlarmRetry_Ena==1)
	{
		gWs_AlarmRetry_Ena = 0;
		if(gMc_Home_Sta==cHomeSta_Err)
		{
			call spAbortWsHome();
			call spResetWsAlarm();
			call Timer.msec(5);
			gMc_Home_Start = 1;
		}
		else if(gWs_Home_Sta==cHomeSta_Err)
		{
			call spAbortWsHome();
			call spResetWsAlarm();
			call Timer.msec(5);
			gWs_Home_Start = 1;
		}
		else
		{
			call spAbortWsLoop();
			call spResetWsAlarm();
			call Timer.msec(5);
			gWs_Loop_Start = 1;

			//20251230 KJH - Manual Mode시 Auto Mode 알람 발생.(방안 모색중)
		}
	}

	if(gVs_AlarmRetry_Ena==1)
	{
		gVs_AlarmRetry_Ena = 0;
		pUmem_Cmd_Vs_AlarmRetry = 0;
		if(gVs_Home_Sta==cHomeSta_Err)
		{
			call spAbortVsHome();
			call spResetVsAlarm();
			call Timer.msec(5);
			gVs_Home_Start = 1;
		}
		else
		{
			call spAbortVsLoop();
			call spResetVsAlarm();
			call Timer.msec(5);
			gVs_Loop_Start = 1;
		}
	}

	if(gWs_AlarmAbort_Ena==1)
	{
		gWs_AlarmAbort_Ena = 0;

		if(gWs_Home_Sta==cHomeSta_Err)
		{
			call spAbortWsHome();
			call spResetWsAlarm();
		}
		else
		{
			call spAbortWsLoop();
			call spResetWsAlarm();
		}
	}

	if(gVs_AlarmAbort_Ena==1)
	{
		gVs_AlarmAbort_Ena = 0;
		pUmem_Cmd_Vs_AlarmAbort = 0;

		if(gVs_Home_Sta==cHomeSta_Err)
		{
			call spAbortVsHome();
			call spResetVsAlarm();
		}
		else
		{
			call spAbortVsLoop();
			call spResetVsAlarm();
		}
	}
//-------------------------------------------------------------//
// Interlock
//-------------------------------------------------------------//
	// Laser Gate Interlock
	if(Coord[1].ProgActive!=1 && gWs_TestShot_Ena!=1 && gWs_LaserTest_Ena!=1 && gWs_PowerCheck_Shot_Sta != 2 && gWs_PowerCheck_Shot_Sta != 1)
	{
		pGpio_Do00_LaserEmission = 0;
	}

	// Scanner Timebase Lock Cancel
	if(Coord[2].ProgActive!=1)
	{
		Coord[2].pDesTimeBase = Coord[2].DesTimeBase.a
	}

//-------------------------------------------------------------//
// Request Signal Clear
//-------------------------------------------------------------//
	if(gWs_Load_Ena!=1)
	{
		if(pUmem_Sta_Ws_2ndTransLdReq!=cPcReq_Err)		pUmem_Sta_Ws_2ndTransLdReq = 0;
		else
		{
			if(pUmem_Cmd_Ws_2ndTransLdRsp==cPcRep_Idl)	pUmem_Sta_Ws_2ndTransLdReq = cPcReq_Idl;
		}
	}
	else
	{
		if(pUmem_Sta_Ws_2ndTransLdReq==cPcReq_Err)
		{
			if(pUmem_Cmd_Ws_2ndTransLdRsp==cPcRep_Idl)	pUmem_Sta_Ws_2ndTransLdReq = cPcReq_Idl;
		}
	}
	if(gWs_Welding_Ena!=1)				pUmem_Sta_Ws_LwmStartReq = 0;
	if(gWs_Reject_Ena!=1)				pUmem_Sta_Ws_1stTransRjReq = 0;
	if(gWs_Ready_Ena!=1)				pUmem_Sta_Ws_2dVisionCkReq = 0;
	if(gVs_Unload_Ena!=1){				pUmem_Sta_Vs_3rdTransUdReq = 0;
										pUmem_Sta_Vs_3rdTransRjReq = 0;}
//	if(gVs_Unload_Ena!=1)				pUmem_Sta_Vs_3rdTransUdReq = 0;
//	if(gVs_Reject_Ena!=1)				pUmem_Sta_Vs_3rdTransRjReq = 0;
//	if(gVs_PostVisionST_Ena!=1)			pUmem_Sta_Vs_3DVisionStReq = 0;
//	if(gVs_PostVisionED_Ena!=1)			pUmem_Sta_Vs_3DVisionEdReq = 0;

close

