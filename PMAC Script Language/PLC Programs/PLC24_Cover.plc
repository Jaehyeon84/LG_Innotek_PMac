				if(gWs_CldIn_CoverUD==cUp)
				{
					gWs_CoverCls_Tmr = Sys.Time + gWs_CldInpos_Delay;
					gWs_CoverCls_Seq = 23;
				}
				else if(Sys.time > gWs_CoverCls_Tmr)
				{
					gWs_CoverCls_Sta = cSeqSta_Err;
