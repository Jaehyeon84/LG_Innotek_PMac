/////////////////////////////////////////////////////////////////////////
// Welding Vision Camera Cover Open
/////////////////////////////////////////////////////////////////////////
	if(gWsV_CoverOpn_Start==1)
	{
		gWsV_CoverOpn_Start = 0;
		gWsV_CoverOpn_Seq = 1;
		gWsV_CoverOpn_Ena = 1;
	}

	if(gWsV_CoverOpn_Abort==1)
	{
		gWsV_CoverOpn_Abort = 0;
		gWsV_CoverOpn_Seq = 0;
		gWsV_CoverOpn_Ena = 0;
	}

	if(gWsV_CoverOpn_Ena)
	{
		switch(gWsV_CoverOpn_Seq)
		{
			case 1:
				gWsV_CoverOpn_Buf = gWsV_CoverOpn_Seq;
				gWsV_CoverOpn_Sta = cSeqSta_Ing;
				if(gWsV_Cover_Cur == cOpn)
				{
					gWsV_Cover_Cur = cOpn;
					gWsV_CoverOpn_Seq = 90;
				}
				else
				{
					gWsV_CoverOpn_Seq = 10;
				}
			break;
		//------------------------------------------------------//
			case 10:
				gWsV_CoverOpn_Buf = gWsV_CoverOpn_Seq;

				pUmem_Do1C_WsVsStrCls = 0;
