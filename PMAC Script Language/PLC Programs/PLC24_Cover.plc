			break;

			case 23:
				gWs_CoverCls_Buf = gWs_CoverCls_Seq;
				if(Sys.time > gWs_CoverCls_Tmr)
				{
					gWs_CoverCls_Seq = 30;
				}
			break;
		//------------------------------------------------------//		
			case 30:
				gWs_CoverCls_Buf = gWs_CoverCls_Seq;
				if(gWs_CldIn_CoverFB==cFwd)
				{
					gWs_CoverCls_Seq = 40;
				}
				else
				{
					gWs_CoverCls_Tmr = Sys.Time + 0.1;
