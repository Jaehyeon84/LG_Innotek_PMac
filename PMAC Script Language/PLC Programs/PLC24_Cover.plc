//######################################################################################################
// PLC 24 : Cover Opne/Close
//######################################################################################################


open plc 24
/////////////////////////////////////////////////////////////////////////
// Welding Stage Cover Open
/////////////////////////////////////////////////////////////////////////
	if(gWs_CoverOpn_Start==1)
	{
		if(gWs_CoverCls_Ena)
			gWs_CoverCls_Abort = 0;

		gWs_CoverOpn_Start = 0;
		gWs_CoverOpn_Sta = cSeqSta_Idl;
		gWs_CoverCls_Sta = cSeqSta_Idl;
		gWs_CoverOpn_Seq = 1;
		gWs_CoverOpn_Ena = 1;

		gWs_ThCoverPos_Old = 0;
	}

	if(gWs_CoverOpn_Abort==1)
	{
		gWs_CoverOpn_Abort = 0;
		gWs_CoverOpn_Seq = 0;
		gWs_CoverOpn_Ena = 0;
	}

	if(gWs_CoverOpn_Ena)
	{
		gWs_CoverMoving_Sta = 1;

		switch(gWs_CoverOpn_Seq)
		{
			case 1:
				gWs_CoverOpn_Buf = gWs_CoverOpn_Seq;
				gWs_CoverOpn_Sta = cSeqSta_Ing;
				if(gWs_CldIn_CoverFB==cBwd && gWs_CldIn_CoverUD==cUp)
				{
					gWs_CoverOpn_Seq = 90;
				}
				else
				{
					gWs_CoverOpn_Seq = 10;
				}
			break;
		//------------------------------------------------------//
			case 10:
				gWs_CoverOpn_Buf = gWs_CoverOpn_Seq;
				//if(pUmem_Sta_CmdPos(nwC) % 360000 == cWs_Cover_MoveAng)
				if(pUmem_Sta_CmdPos(nwC) == cWs_Cover_MoveAng)
				{
					gWs_CoverOpn_Seq = 20;
				}
				else
				{
					gWs_CoverOpn_Seq = 11;
				}
			break;


			case 11:
				gWs_CoverOpn_Buf = gWs_CoverOpn_Seq;
				if(Motor[nwC].AmpEna==1)
				{
					//20260126 KJH - 최단 거리 Open과 Close 하기 위함.
//					gPosCBuf = pUmem_Sta_ActPos(nwC) / 360000;
//					if(gPosCBuf > 0)
//					{
//						gPosCBuf = 0 - (pUmem_Sta_ActPos(nwC) % 360000);
//						if(pUmem_Sta_ActPos(nwC) < 0 )
//							Motor[nwC].ProgJogPos = pUmem_Sta_ActPos(nwC) + gPosCBuf;
//						else
//							Motor[nwC].ProgJogPos = pUmem_Sta_ActPos(nwC) - gPosCBuf;
//					}
//					else
//						Motor[nwC].ProgJogPos = cWs_Cover_MoveAng;
					call spReadWsThPos(nwC, cWs_Cover_MoveAng, &gWs_ThCoverPos_Old);
					//gWs_ThCoverPos_Old = Motor[nwC].ProgJogPos;
					//Motor[nwC].ProgJogPos = cWs_Cover_MoveAng;
					//Motor[nwC].ProgJogPos = outc_pos;

					jog nwC=*
					gWs_CoverOpn_Tmr = Sys.Time + 0.1;
					gWs_CoverOpn_Seq = 12;
				}
				else
				{
					gWs_CoverOpn_Sta = cSeqSta_Err;
					gWs_CoverOpn_Seq = 0;
					gWs_CoverOpn_Ena = 0;
				}
			break;

			case 12:
				gWs_CoverOpn_Buf = gWs_CoverOpn_Seq;
				if(Sys.time > gWs_CoverOpn_Tmr)
				{
					gWs_CoverOpn_Tmr = Sys.Time + cSeq_MtrTimeOut;
					gWs_CoverOpn_Seq = 13;
				}
			break;

			case 13:
				gWs_CoverOpn_Buf = gWs_CoverOpn_Seq;
				if(Motor[nwC].InPos==1)
				{
					gWs_CoverOpn_Seq = 20;
				}
				if(Sys.time > gWs_CoverOpn_Tmr)
				{
					gWs_CoverOpn_Sta = cSeqSta_Err;
					gWs_CoverOpn_Seq = 0;
					gWs_CoverOpn_Ena = 0;
				}
			break;
		//------------------------------------------------------//
			case 20:
				gWs_CoverOpn_Buf = gWs_CoverOpn_Seq;
				if(gWs_CldIn_CoverUD==cUp)
				{
					gWs_CoverOpn_Seq = 30;
				}
				else
				{
					pUmem_Do12_WsTbFixDn = 0;
					pUmem_Do10_WsTbFixUp = 1;
					gWs_CoverOpn_Tmr = Sys.Time + 0.1;
					gWs_CoverOpn_Seq = 21;
				}
			break;

			case 21:
				gWs_CoverOpn_Buf = gWs_CoverOpn_Seq;
				if(Sys.time > gWs_CoverOpn_Tmr)
				{
					gWs_CoverOpn_Tmr = Sys.Time + cSeq_CldTimeOut;
					gWs_CoverOpn_Seq = 22;
				}
			break;

			case 22:
				gWs_CoverOpn_Buf = gWs_CoverOpn_Seq;
				if(gWs_CldIn_CoverUD==cUp)
				{
					gWs_CoverOpn_Tmr = Sys.Time + gWs_CldInpos_Delay;
					gWs_CoverOpn_Seq = 23;
				}
				else if(Sys.time > gWs_CoverOpn_Tmr)
				{
					gWs_CoverOpn_Sta = cSeqSta_Err;
					gWs_CoverOpn_Seq = 0;
					gWs_CoverOpn_Ena = 0;
				}
			break;

			case 23:
				gWs_CoverOpn_Buf = gWs_CoverOpn_Seq;
				if(Sys.time > gWs_CoverOpn_Tmr)
				{
					gWs_CoverOpn_Seq = 30;
				}
			break;
		//------------------------------------------------------//
			case 30:
				gWs_CoverOpn_Buf = gWs_CoverOpn_Seq;
				if(gWs_CldIn_CoverFB==cBwd)
				{
					gWs_CoverOpn_Seq = 90;
				}
				else
				{
					gWs_CoverOpn_Tmr = Sys.Time + 0.1;
					gWs_CoverOpn_Seq = 31;
				}
			break;

			case 31:
				gWs_CoverOpn_Buf = gWs_CoverOpn_Seq;
				if(Sys.time > gWs_CoverOpn_Tmr)
				{
					gWs_EcldBwd_Sta = cEcldSta_Idl;
					pUmem_Do30_EcldFwd = 0;
					pUmem_Do31_EcldBwd = 1;
					gWs_CoverOpn_Tmr = Sys.Time + cSeq_CldTimeOut;
					gWs_CoverOpn_Seq = 32;
				}
			break;

			case 32:
				gWs_CoverOpn_Buf = gWs_CoverOpn_Seq;
				if(gWs_CldIn_CoverFB==cBwd)
				{
					gWs_CoverOpn_Tmr = Sys.Time + gWs_CldInpos_Delay;
					gWs_CoverOpn_Seq = 33;
				}
				else if(Sys.time > gWs_CoverOpn_Tmr)
				{
					gWs_CoverOpn_Sta = cSeqSta_Err;
					gWs_CoverOpn_Seq = 0;
					gWs_CoverOpn_Ena = 0;
				}
			break;

			case 33:
				gWs_CoverOpn_Buf = gWs_CoverOpn_Seq;
				if(Sys.time > gWs_CoverOpn_Tmr)
				{
					gWs_CoverOpn_Seq = 90;
				}
			break;
		//------------------------------------------------------//
			case 90:
				gWs_CoverOpn_Buf = gWs_CoverOpn_Seq;
				gWs_CoverOpn_Sta = cSeqSta_Fin;
				gWs_CoverOpn_Seq = 0;
				gWs_CoverOpn_Ena = 0;
			break;

			default:
				gWs_CoverOpn_Err = -1;
				gWs_CoverOpn_Sta = cSeqSta_Err;
				gWs_CoverOpn_Seq = 0;
				gWs_CoverOpn_Ena = 0;
			break;
		}
	}

/////////////////////////////////////////////////////////////////////////
