	gVs_AlarmRetry_Cur = pUmem_Cmd_Vs_AlarmRetry;
	if(gVs_AlarmRetry_Cur != gVs_AlarmRetry_Old)
	{
		gVs_AlarmRetry_Old = gVs_AlarmRetry_Cur;
		if(gVs_AlarmRetry_Cur == 1)
		{
			gVs_AlarmRetry_Ena = 1;
			pUmem_Cmd_Vs_AlarmRetry = 0;
		}
	}

	gVs_AlarmAbort_Cur = pUmem_Cmd_Vs_AlarmAbort;
	if(gVs_AlarmAbort_Cur != gVs_AlarmAbort_Old)
	{
		gVs_AlarmAbort_Old = gVs_AlarmAbort_Cur;
		if(gVs_AlarmAbort_Cur == 1)
		{
			gVs_AlarmAbort_Ena = 1;
			pUmem_Cmd_Vs_AlarmAbort = 0;
		}
	}

	gVs_TestShot_Cur = pUmem_Cmd_Vs_TestShot;
	if(gVs_TestShot_Cur != gVs_TestShot_Old)
	{
		gVs_TestShot_Old = gVs_TestShot_Cur;
		if(gVs_TestShot_Cur == 1)
		{
			gVs_TestShot_Seq = 1;
			gVs_TestShot_Ena = 1;
			pUmem_Cmd_Vs_TestShot = 0;
		}
	}

	////////////////////////////////////////////////////////////////////////////////////////////////////
	// Scanner Command
	////////////////////////////////////////////////////////////////////////////////////////////////////

	gSc_ServoOn_Cur = pUmem_Cmd_Sc_ServoOn;
	if(gSc_ServoOn_Cur != gSc_ServoOn_Old)
	{
		gSc_ServoOn_Old = gSc_ServoOn_Cur;
		if(gSc_ServoOn_Cur == 1)
		{
			gSc_ServoOn_Ena = 1;
			pUmem_Cmd_Sc_ServoOn = 0;
		}
	}

	gSc_ServoOff_Cur = pUmem_Cmd_Sc_ServoOff;
	if(gSc_ServoOff_Cur != gSc_ServoOff_Old)
	{
		gSc_ServoOff_Old = gSc_ServoOff_Cur;
		if(gSc_ServoOff_Cur == 1)
		{
			gSc_ServoOff_Ena = 1;
			pUmem_Cmd_Sc_ServoOff = 0;
		}
	}

	gSc_HomeStart_Cur = pUmem_Cmd_Sc_HomeStart;
	if(gSc_HomeStart_Cur != gSc_HomeStart_Old)
	{
		gSc_HomeStart_Old = gSc_HomeStart_Cur;
		if(gSc_HomeStart_Cur == 1)
		{
