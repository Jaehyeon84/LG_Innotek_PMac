//		}
	}

	gSc_HomeAbort_Cur = pUmem_Cmd_Sc_HomeAbort;
	if(gSc_HomeAbort_Cur != gSc_HomeAbort_Old)
	{
		gSc_HomeAbort_Old = gSc_HomeAbort_Cur;
		if(gSc_HomeAbort_Cur == 1)
		{
			gSc_Home_Abort = 1;
			pUmem_Cmd_Sc_HomeAbort = 0;
		}
	}

	gSc_AlarmReset_Cur = pUmem_Cmd_Sc_AlarmReset;
	if(gSc_AlarmReset_Cur != gSc_AlarmReset_Old)
	{
		gSc_AlarmReset_Old = gSc_AlarmReset_Cur;
		if(gSc_AlarmReset_Cur == 1)
		{
			gSc_AlarmReset_Ena = 1;
			pUmem_Cmd_Sc_AlarmReset = 0;
