//######################################################################################################
// PLC 03 : Command PLC : PC -> PPMAC
//######################################################################################################


open plc 3
	local cmd_idx = 0;
	local cod_idx = 0;

	gCmd_Idx++;									// Polling Motor Index
	if(gCmd_Idx > cMtrNum)	gCmd_Idx = cMtrLow;

	cmd_idx = gCmd_Idx;							// Copy Globlal Variable to Local Variable (Because Array Index Can't used Double(global) Type)
	cod_idx = Motor[cmd_idx].Coord;

	////////////////////////////////////////////////////////////////////////////////////////////////////
	// Motor Command
	////////////////////////////////////////////////////////////////////////////////////////////////////

	//--------------------------------------------------------------------------------------------//
	// Home Command (to PLC10_Home)
	//--------------------------------------------------------------------------------------------//
	gMt_HomeStart_Cur(cmd_idx) = pUmem_Cmd_HomeStart(cmd_idx);
	if(gMt_HomeStart_Cur(cmd_idx) != gMt_HomeStart_Old(cmd_idx))
	{
		gMt_HomeStart_Old(cmd_idx) = gMt_HomeStart_Cur(cmd_idx);
		if(gMt_HomeStart_Cur(cmd_idx) == 1)
		{
			gMt_Home_Start(cmd_idx) = 1;
			pUmem_Cmd_HomeStart(cmd_idx) = 0;
		}
	}

	gMt_HomeAbort_Cur(cmd_idx) = pUmem_Cmd_HomeAbort(cmd_idx);
	if(gMt_HomeAbort_Cur(cmd_idx) != gMt_HomeAbort_Old(cmd_idx))
	{
		gMt_HomeAbort_Old(cmd_idx) = gMt_HomeAbort_Cur(cmd_idx);		
		if(gMt_HomeAbort_Cur(cmd_idx) == 1)
		{
			gMt_Home_Abort(cmd_idx) = 1;
			pUmem_Cmd_HomeAbort(cmd_idx) = 0;
		}
	}

	//--------------------------------------------------------------------------------------------//
	// Servo On/Off 
	//--------------------------------------------------------------------------------------------//
	gMt_ServoOn_Cur(cmd_idx) = pUmem_Cmd_ServoOn(cmd_idx);
	if(gMt_ServoOn_Cur(cmd_idx) != gMt_ServoOn_Old(cmd_idx))
	{
		gMt_ServoOn_Old(cmd_idx) = gMt_ServoOn_Cur(cmd_idx);
		if(gMt_ServoOn_Cur(cmd_idx) == 1)
		{
			gMt_ServoOn_Ena(cmd_idx) = 1;						// Motor Servo On
			pUmem_Cmd_ServoOn(cmd_idx) = 0;
		}
	}

	gMt_ServoOff_Cur(cmd_idx) = pUmem_Cmd_ServoOff(cmd_idx);
	if(gMt_ServoOff_Cur(cmd_idx) != gMt_ServoOff_Old(cmd_idx))
	{
		gMt_ServoOff_Old(cmd_idx) = gMt_ServoOff_Cur(cmd_idx);		
		if(gMt_ServoOff_Cur(cmd_idx) == 1)
		{
			gMt_ServoOff_Ena(cmd_idx) = 1;						// Motor Servo Off
			pUmem_Cmd_ServoOff(cmd_idx) = 0;
		}
	}

	//--------------------------------------------------------------------------------------------//
	// Jog Command (to PLC11_Jog)
	//--------------------------------------------------------------------------------------------//
	if(coord[cod_idx].ProgActive!=1)
	{
		gMt_Jog_Stop_Cur(cmd_idx) = pUmem_Cmd_JogStop(cmd_idx);
		if(gMt_Jog_Stop_Cur(cmd_idx) != gMt_Jog_Stop_Old(cmd_idx))
		{
			gMt_Jog_Stop_Old(cmd_idx) = gMt_Jog_Stop_Cur(cmd_idx);
			if(gMt_Jog_Stop_Cur(cmd_idx) == 1)
			{
				gJog_Stop_Ena(cmd_idx) = 1;				// Stop Jog Move
				pUmem_Cmd_JogStop(cmd_idx) = 0;
			}
		}

		gMt_Jog_ContPlus_Cur(cmd_idx) = pUmem_Cmd_JogContPlus(cmd_idx);
		if(gMt_Jog_ContPlus_Cur(cmd_idx) != gMt_Jog_ContPlus_Old(cmd_idx))
		{
			gMt_Jog_ContPlus_Old(cmd_idx) = gMt_Jog_ContPlus_Cur(cmd_idx);
			if(gMt_Jog_ContPlus_Cur(cmd_idx) == 1)
			{
				gJog_ContPlus_Ena(cmd_idx) = 1;				// Jog Move Start Positive Direction
			}
			else
			{
				gJog_Stop_Ena(cmd_idx) = 1;					// Stop Jog Move When Falling Edge of Jog Plus Command
			}
		}

		gMt_Jog_ContMinus_Cur(cmd_idx) = pUmem_Cmd_JogContMinus(cmd_idx);
		if(gMt_Jog_ContMinus_Cur(cmd_idx) != gMt_Jog_ContMinus_Old(cmd_idx))
		{
			gMt_Jog_ContMinus_Old(cmd_idx) = gMt_Jog_ContMinus_Cur(cmd_idx);
			if(gMt_Jog_ContMinus_Cur(cmd_idx) == 1)
			{
				gJog_ContMinus_Ena(cmd_idx) = 1;			// Jog Move Start Negative Direction
			}
			else
			{
				gJog_Stop_Ena(cmd_idx) = 1;					// Stop Jog Move When Falling Edge of Jog Minus Command
			}
		}

		gMt_Jog_AbsMove_Cur(cmd_idx) = pUmem_Cmd_JogAbsMove(cmd_idx);
		if(gMt_Jog_AbsMove_Cur(cmd_idx) != gMt_Jog_AbsMove_Old(cmd_idx))
		{
			gMt_Jog_AbsMove_Old(cmd_idx) = gMt_Jog_AbsMove_Cur(cmd_idx);
			if(gMt_Jog_AbsMove_Cur(cmd_idx) == 1)
			{
				gJog_AbsMove_Ena(cmd_idx) = 1;			// Start Motor Absolute Move
				pUmem_Cmd_JogAbsMove(cmd_idx) = 0;
			}
		}

		gMt_Jog_IncMove_Cur(cmd_idx) = pUmem_Cmd_JogIncMove(cmd_idx);
		if(gMt_Jog_IncMove_Cur(cmd_idx) != gMt_Jog_IncMove_Old(cmd_idx))
		{
			gMt_Jog_IncMove_Old(cmd_idx) = gMt_Jog_IncMove_Cur(cmd_idx);
			if(gMt_Jog_IncMove_Cur(cmd_idx) == 1)
			{
				gJog_IncMove_Ena(cmd_idx) = 1;			// Start Motor Incremental Move
				pUmem_Cmd_JogIncMove(cmd_idx) = 0;
			}
		}
	}

	////////////////////////////////////////////////////////////////////////////////////////////////////
	// Machine Command
	////////////////////////////////////////////////////////////////////////////////////////////////////
	gMc_ServoOn_Cur = pUmem_Cmd_Mc_ServoOn;
	if(gMc_ServoOn_Cur != gMc_ServoOn_Old)
	{
		gMc_ServoOn_Old = gMc_ServoOn_Cur;
		if(gMc_ServoOn_Cur == 1)
		{
			gMc_ServoOn_Ena = 1;
			pUmem_Cmd_Mc_ServoOn = 0;
		}
	}

	gMc_ServoOff_Cur = pUmem_Cmd_Mc_ServoOff;
	if(gMc_ServoOff_Cur != gMc_ServoOff_Old)
	{
		gMc_ServoOff_Old = gMc_ServoOff_Cur;
		if(gMc_ServoOff_Cur == 1)
		{
			gMc_ServoOff_Ena = 1;
			pUmem_Cmd_Mc_ServoOff = 0;
		}
	}

	gMc_HomeStart_Cur = pUmem_Cmd_Mc_HomeStart;
	if(gMc_HomeStart_Cur != gMc_HomeStart_Old)
	{
		gMc_HomeStart_Old = gMc_HomeStart_Cur;
		if(gMc_HomeStart_Cur == 1)
		{
			gMc_Home_Start = 1;
			pUmem_Cmd_Mc_HomeStart = 0;
		}
	}
//	else if(gMc_HomeStart_Cur==0 && gMc_HomeStart_Old==1)
//	{
//		gMc_HomeStart_Old = gMc_HomeStart_Cur;
//		gMc_Home_Sta = cHomeSta_Idl;
//	}

	gMc_HomeAbort_Cur = pUmem_Cmd_Mc_HomeAbort;
	if(gMc_HomeAbort_Cur != gMc_HomeAbort_Old)
	{
		gMc_HomeAbort_Old = gMc_HomeAbort_Cur;
		if(gMc_HomeAbort_Cur == 1)
		{
			gMc_Home_Abort = 1;
			pUmem_Cmd_Mc_HomeAbort = 0;
		}
	}

	gMc_AlarmReset_Cur = pUmem_Cmd_Mc_AlarmReset;
	if(gMc_AlarmReset_Cur != gMc_AlarmReset_Old)
	{
		gMc_AlarmReset_Old = gMc_AlarmReset_Cur;
		if(gMc_AlarmReset_Cur == 1)
		{
			gMc_AlarmReset_Ena = 1;
			pUmem_Cmd_Mc_AlarmReset = 0;
		}
	}

//	if(gKey_RunMod != pUmem_Cmd_Mc_RunMode)
//	{
//		gKey_RunMod = pUmem_Cmd_Mc_RunMode;	//20251230 KJH - gKey_RunMod는 Switch 값을 전달 받는 값.
//	}
	gKey_RunMod = 1; // Test 시 임시

	gMc_AutoStart_Cur = pUmem_Cmd_Mc_AutoStart;
	if(gMc_AutoStart_Cur != gMc_AutoStart_Old)
	{
		gMc_AutoStart_Old = gMc_AutoStart_Cur;
		if(gMc_AutoStart_Cur == 1)
		{
			gMc_AutoRun_Start = 1;
			pUmem_Cmd_Mc_AutoStart = 0;
		}
	}

	gMc_AutoAbort_Cur = pUmem_Cmd_Mc_AutoAbort;
	if(gMc_AutoAbort_Cur != gMc_AutoAbort_Old)
	{
		gMc_AutoAbort_Old = gMc_AutoAbort_Cur;
		if(gMc_AutoAbort_Cur == 1)
		{
			gMc_AutoRun_Abort = 1;
			pUmem_Cmd_Mc_AutoAbort = 0;
		}
	}

	gMc_AutoPause_Cur = pUmem_Cmd_Mc_AutoPause;
	if(gMc_AutoPause_Cur != gMc_AutoPause_Old)
	{
		gMc_AutoPause_Old = gMc_AutoPause_Cur;
		if(gMc_AutoPause_Cur == 1)
		{
			gMc_AutoRun_Pause = 1;
			pUmem_Cmd_Mc_AutoPause = 0;
		}
	}

	gMc_CycleStart_Cur = pUmem_Cmd_Mc_CycleStart;
	if(gMc_CycleStart_Cur != gMc_CycleStart_Old)
	{
		gMc_CycleStart_Old = gMc_CycleStart_Cur;
		if(gMc_CycleStart_Cur == 1)
		{
			gMc_Cycle_Start = 1;
			pUmem_Cmd_Mc_CycleStart = 0;
		}
	}

	gMc_StepStart_Cur = pUmem_Cmd_Mc_StepStart;
	if(gMc_StepStart_Cur != gMc_StepStart_Old)
	{
		gMc_StepStart_Old = gMc_StepStart_Cur;
		if(gMc_StepStart_Cur == 1)
		{
			gMc_Step_Start = 1;
			pUmem_Cmd_Mc_StepStart = 0;
		}
	}

	gMc_Fsave_Cur = pUmem_Cmd_Mc_Fsave;
	if(gMc_Fsave_Cur != gMc_Fsave_Old)
	{
		gMc_Fsave_Old = gMc_Fsave_Cur;
		if(gMc_Fsave_Cur == 1)
		{
			cmd"fsave"
			pUmem_Cmd_Mc_Fsave = 0;
		}		
	}

	////////////////////////////////////////////////////////////////////////////////////////////////////
	// Welding Command
	////////////////////////////////////////////////////////////////////////////////////////////////////
	gWs_ServoOn_Cur = pUmem_Cmd_Ws_ServoOn;
	if(gWs_ServoOn_Cur != gWs_ServoOn_Old)
	{
		gWs_ServoOn_Old = gWs_ServoOn_Cur;
		if(gWs_ServoOn_Cur == 1)
		{
			gWs_ServoOn_Ena = 1;
			pUmem_Cmd_Ws_ServoOn = 0;
		}
	}

	gWs_ServoOff_Cur = pUmem_Cmd_Ws_ServoOff;
	if(gWs_ServoOff_Cur != gWs_ServoOff_Old)
	{
		gWs_ServoOff_Old = gWs_ServoOff_Cur;
		if(gWs_ServoOff_Cur == 1)
		{
			gWs_ServoOff_Ena = 1;
			pUmem_Cmd_Ws_ServoOff = 0;
		}
	}

	gWs_HomeStart_Cur = pUmem_Cmd_Ws_HomeStart;
	if(gWs_HomeStart_Cur != gWs_HomeStart_Old)
	{
		gWs_HomeStart_Old = gWs_HomeStart_Cur;
		if(gWs_HomeStart_Cur == 1)
		{
			gWs_Home_Start = 1;
			 pUmem_Cmd_Ws_HomeStart = 0;
		}
//		else
//		{
//			gWs_Home_Start = cHomeSta_Idl;
//		}
	}

	gWs_HomeAbort_Cur = pUmem_Cmd_Ws_HomeAbort;
	if(gWs_HomeAbort_Cur != gWs_HomeAbort_Old)
	{
		gWs_HomeAbort_Old = gWs_HomeAbort_Cur;
		if(gWs_HomeAbort_Cur == 1)
		{
			gWs_Home_Abort = 1;
			pUmem_Cmd_Ws_HomeAbort = 0;
		}
	}

	gWs_AlarmReset_Cur = pUmem_Cmd_Ws_AlarmReset;
	if(gWs_AlarmReset_Cur != gWs_AlarmReset_Old)
	{
		gWs_AlarmReset_Old = gWs_AlarmReset_Cur;
		if(gWs_AlarmReset_Cur == 1)
		{
			gWs_AlarmReset_Ena = 1;
			pUmem_Cmd_Ws_AlarmReset = 0;
		}
	}

	gWs_AlarmRetry_Cur = pUmem_Cmd_Ws_AlarmRetry;
	if(gWs_AlarmRetry_Cur != gWs_AlarmRetry_Old)
	{
		gWs_AlarmRetry_Old = gWs_AlarmRetry_Cur;
		if(gWs_AlarmRetry_Cur == 1)
		{
			gWs_AlarmRetry_Ena = 1;
			pUmem_Cmd_Ws_AlarmRetry = 0;
		}
	}

	gWs_AlarmAbort_Cur = pUmem_Cmd_Ws_AlarmAbort;
	if(gWs_AlarmAbort_Cur != gWs_AlarmAbort_Old)
	{
		gWs_AlarmAbort_Old = gWs_AlarmAbort_Cur;
		if(gWs_AlarmAbort_Cur == 1)
		{
			gWs_AlarmAbort_Ena = 1;
			pUmem_Cmd_Ws_AlarmAbort = 0;
		}
	}

	gWs_PowerCheck_Cur = pUmem_Cmd_Ws_TestShot;
	if(gWs_PowerCheck_Cur != gWs_PowerCheck_Old)
	{
		gWs_PowerCheck_Old = gWs_PowerCheck_Cur;
		if(gWs_PowerCheck_Cur == 1)
		{
			gWs_TestShot_Ena = 1;
			pUmem_Cmd_Ws_TestShot = 0;
		}
	}

	gWs_TestShot_Cur = pUmem_Cmd_Ws_TestShot;
	if(gWs_TestShot_Cur != gWs_TestShot_Old)
	{
		gWs_TestShot_Old = gWs_TestShot_Cur;
		if(gWs_TestShot_Cur == 1)
		{
			gWs_TestShot_Ena = 1;
			pUmem_Cmd_Ws_TestShot = 0;
		}
	}

	gWs_LaserEnableStart_Cur = pUmem_Cmd_Ws_LaserEnableStart;
	if(gWs_LaserEnableStart_Cur != gWs_LaserEnableStart_Old)
	{
		gWs_LaserEnableStart_Old = gWs_LaserEnableStart_Cur;
		if(gWs_LaserEnableStart_Cur == 1)
		{
			gWs_LaserEnable_Start = 1;
			pUmem_Cmd_Ws_LaserEnableStart = 0;
		}
	}

	gWs_LaserDisableStart_Cur = pUmem_Cmd_Ws_LaserDisableStart;
	if(gWs_LaserDisableStart_Cur != gWs_LaserDisableStart_Old)
	{
		gWs_LaserDisableStart_Old = gWs_LaserDisableStart_Cur;
		if(gWs_LaserDisableStart_Cur == 1)
		{
			gWs_LaserDisable_Start = 1;
			pUmem_Cmd_Ws_LaserDisableStart = 0;
		}
	}

	gWs_LaserTestCrossStart_Cur = pUmem_Cmd_Ws_LaserTestCrossStart;
	if(gWs_LaserTestCrossStart_Cur != gWs_LaserTestCrossStart_Old)
	{
		gWs_LaserTestCrossStart_Old = gWs_LaserTestCrossStart_Cur;
		if(gWs_LaserTestCrossStart_Cur == 1)
		{
			gWs_LaserTestCross_Start = 1;
			pUmem_Cmd_Ws_LaserTestCrossStart = 0;
		}
	}

	gWs_LaserTestCrossAbort_Cur = pUmem_Cmd_Ws_LaserTestCrossAbort;
	if(gWs_LaserTestCrossAbort_Cur != gWs_LaserTestCrossAbort_Old)
	{
		gWs_LaserTestCrossAbort_Old = gWs_LaserTestCrossAbort_Cur;
		if(gWs_LaserTestCrossAbort_Cur == 1)
		{
			gWs_LaserTestCross_Abort = 1;
			 pUmem_Cmd_Ws_LaserTestCrossAbort = 0;
		}
	}

	gWs_LaserTestLineStart_Cur = pUmem_Cmd_Ws_LaserTestLineStart;
	if(gWs_LaserTestLineStart_Cur != gWs_LaserTestLineStart_Old)
	{
		gWs_LaserTestLineStart_Old = gWs_LaserTestLineStart_Cur;
		if(gWs_LaserTestLineStart_Cur == 1)
		{
			gWs_LaserTestLine_Start = 1;
			pUmem_Cmd_Ws_LaserTestLineStart = 0;
		}
	}

	gWs_LaserTestLineAbort_Cur = pUmem_Cmd_Ws_LaserTestLineAbort;
	if(gWs_LaserTestLineAbort_Cur != gWs_LaserTestLineAbort_Old)
	{
		gWs_LaserTestLineAbort_Old = gWs_LaserTestLineAbort_Cur;
		if(gWs_LaserTestLineAbort_Cur == 1)
		{
			gWs_LaserTestLine_Abort = 1;
			pUmem_Cmd_Ws_LaserTestLineAbort = 0;
		}
	}

	gWs_PowerCheckStart_Cur = pUmem_Cmd_Ws_PowerCheckStart;
	if(gWs_PowerCheckStart_Cur != gWs_PowerCheckStart_Old)
	{
		gWs_PowerCheckStart_Old = gWs_PowerCheckStart_Cur;
		if(gWs_PowerCheckStart_Cur == 1)
		{
			enable plc 26;
			gWs_PowerCheck_Shot_Start = 1;
			pUmem_Cmd_Ws_PowerCheckStart = 0;
		}
	}

	gWs_PowerCheckAbort_Cur = pUmem_Cmd_Ws_PowerCheckAbort;
	if(gWs_PowerCheckAbort_Cur != gWs_PowerCheckAbort_Old)
	{
		gWs_PowerCheckAbort_Old = gWs_PowerCheckAbort_Cur;
		if(gWs_PowerCheckAbort_Cur == 1)
		{
			gWs_PowerCheck_Shot_Abort = 1;
			pUmem_Cmd_Ws_PowerCheckAbort = 0;
		}
	}
	////////////////////////////////////////////////////////////////////////////////////////////////////
	// Vision Command
	////////////////////////////////////////////////////////////////////////////////////////////////////
	gVs_ServoOn_Cur = pUmem_Cmd_Vs_ServoOn;
	if(gVs_ServoOn_Cur != gVs_ServoOn_Old)
	{
		gVs_ServoOn_Old = gVs_ServoOn_Cur;
		if(gVs_ServoOn_Cur == 1)
		{
			gVs_ServoOn_Ena = 1;
			pUmem_Cmd_Vs_ServoOn = 0;
		}
	}

	gVs_ServoOff_Cur = pUmem_Cmd_Vs_ServoOff;
	if(gVs_ServoOff_Cur != gVs_ServoOff_Old)
	{
		gVs_ServoOff_Old = gVs_ServoOff_Cur;
		if(gVs_ServoOff_Cur == 1)
		{
			gVs_ServoOff_Ena = 1;
			pUmem_Cmd_Vs_ServoOff = 0;
		}
	}

	gVs_HomeStart_Cur = pUmem_Cmd_Vs_HomeStart;
	if(gVs_HomeStart_Cur != gVs_HomeStart_Old)
	{
		gVs_HomeStart_Old = gVs_HomeStart_Cur;
		if(gVs_HomeStart_Cur == 1)
		{
			gVs_Home_Start = 1;
			pUmem_Cmd_Vs_HomeStart = 0;
		}
//		else
//		{
//			gVs_Home_Sta = cHomeSta_Idl;
//		}
	}

	gVs_HomeAbort_Cur = pUmem_Cmd_Vs_HomeAbort;
	if(gVs_HomeAbort_Cur != gVs_HomeAbort_Old)
	{
		gVs_HomeAbort_Old = gVs_HomeAbort_Cur;
		if(gVs_HomeAbort_Cur == 1)
		{
			gVs_Home_Abort = 1;
			pUmem_Cmd_Vs_HomeAbort = 0;
		}
	}

	gVs_AlarmReset_Cur = pUmem_Cmd_Vs_AlarmReset;
	if(gVs_AlarmReset_Cur != gVs_AlarmReset_Old)
	{
		gVs_AlarmReset_Old = gVs_AlarmReset_Cur;
		if(gVs_AlarmReset_Cur == 1)
		{
			gVs_AlarmReset_Ena = 1;
			pUmem_Cmd_Vs_AlarmReset = 0;
		}
