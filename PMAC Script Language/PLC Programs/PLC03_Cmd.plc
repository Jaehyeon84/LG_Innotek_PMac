	if(pUmem_Cmd_Ws_CldInposDelay>0)	gWs_CldInpos_Delay = pUmem_Cmd_Ws_CldInposDelay/1000
	if(pUmem_Cmd_Vs_CldInposDelay>0)	gVs_CldInpos_Delay = pUmem_Cmd_Vs_CldInposDelay/1000
