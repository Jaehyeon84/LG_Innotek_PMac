	gWs_PdtStaChange_Cur = pUmem_Cmd_Ws_PdtStaChange;
	if(gWs_PdtStaChange_Cur != gWs_PdtStaChange_Old || gWs_PdtStaChange_Cur == 0 && pUmem_Sta_Mc_ErasePdtFlgWs == 1)
	{
		gWs_PdtStaChange_Old = gWs_PdtStaChange_Cur;
		if(gWs_PdtStaChange_Cur == 1)
		{
			//gWs_PdtStaChange_Ena = 1;

			if(gWs_Loop_Ena==0)
			{
				if(gWs_Sta_Pdt==cPdtSta_Err)
				{
					//20260118 KJH - Welding Program에서 Grid Click 했을때만 지워 지도록 변경.
					pUmem_Sta_Mc_ErasePdtFlgWs = 1;
					pUmem_Sta_Mc_ErasePdtNoWs = gWs_PdtNo;
					pUmem_Sta_Ws_PosProduct = 0;

					gWs_Sta_Pdt = cPdtSta_Blk;
				}
				else if(gWs_Sta_Pdt==cPdtSta_Blk)	gWs_Sta_Pdt = cPdtSta_Bwd;
				else if(gWs_Sta_Pdt==cPdtSta_Bwd)	gWs_Sta_Pdt = cPdtSta_Awd;
				else if(gWs_Sta_Pdt==cPdtSta_Awd)	gWs_Sta_Pdt = cPdtSta_Err;
			}
		}
		else
		{
			pUmem_Sta_Mc_ErasePdtFlgWs = 0;
		}

		//20260206 KJH - Welding Program에서 Product Info 삭제후 pUmem_Cmd_Ws_PdtStaChange Flag Off 방식.
		if(pUmem_Sta_Mc_ErasePdtFlgWs != 1)
		{
			pUmem_Cmd_Ws_PdtStaChange = 0;
			gWs_PdtStaChange_Old = 0;
		}
	}

