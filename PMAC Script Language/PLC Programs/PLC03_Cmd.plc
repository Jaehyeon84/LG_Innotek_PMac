	if(gVs_PdtStaChange_Cur != gVs_PdtStaChange_Old || gVs_PdtStaChange_Cur == 0 && pUmem_Sta_Mc_ErasePdtFlgVs == 1)
	{
		gVs_PdtStaChange_Old = gVs_PdtStaChange_Cur;
		if(gVs_PdtStaChange_Cur == 1)
		{
			//gVs_PdtStaChange_Ena = 1;
			//pUmem_Cmd_Vs_PdtStaChange = 0;

			if(gVs_Loop_Ena==0)
			{
				if(gVs_Sta_Pdt==cPdtSta_Err)
				{
					//20260118 KJH - Welding Program에서 Grid Click 했을때만 지워 지도록 변경.
