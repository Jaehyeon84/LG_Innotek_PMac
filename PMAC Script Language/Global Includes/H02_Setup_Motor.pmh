	Motor[nvY].pCaptEna =  Slave_1005_R88D_1SN01H_ECT_60B8_0_Touchprobefunction.a
	Motor[nvY].CaptEnaBit = 4;
	Motor[nvY].pCaptFlag = Slave_1005_R88D_1SN01H_ECT_60B9_0_Touchprobestatus.a; 
	Motor[nvY].CaptFlagBit = 1;
	Motor[nvY].pCaptPos = Slave_1005_R88D_1SN01H_ECT_60BA_0_Touchprobepos1posvalue.a;
	Motor[nvY].CaptPosLeftShift = 0;                
