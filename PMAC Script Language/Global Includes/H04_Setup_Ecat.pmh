//######################################################################################################
// Header 04 : Setup EtherCat
//######################################################################################################


ECAT[0].RTStateCheck = 1;				// EtherCat Connection/Status Check Enable
ECAT[0].RTStateCheckCount = 9;			// EtherCat Connection/Status Check Period
ECAT[0].ServoExtension = rint(1/Sys.ServoPeriod/2-1);	// EtherCat Servo Period
ECAT[0].AllowInputsOnWkcErr = 1;		// When EtherCat Disconnection, Allow Digital Input
ECAT[0].DCMaxAdjust = 4000;				// For Decrease Jitter, Increase ECAT[x].DCMaxAdjust

Motor[nwX].EcatAmpFaultLimit = 40000;	// Increase Fault Wait Time. For Motor Phasing
Motor[nwY].EcatAmpFaultLimit = 40000;
