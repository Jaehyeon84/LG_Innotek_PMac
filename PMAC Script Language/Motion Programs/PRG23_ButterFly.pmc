

open prog 23
	local rad, move_time,det = 0;

	rad = gWs_WblLen/1000/2
	move_time = gWs_WblDst/(Coord[1].Tm*-1)
	gWs_WblCnt = 0

	if(Ldata.coord!=2) return
	if(gWs_WblRatW<=0 || gWs_WblRatL<=0) return;

	tsel 1
	det = tinit(1);
	Tdata[1].Bias[6] = gWs_WblOfsX/1000
	Tdata[1].Bias[7] = gWs_WblOfsY/1000
	Tdata[1].Diag[6] = gWs_WblRatW/100
	Tdata[1].Diag[7] = gWs_WblRatL/100
	
	Coord[2].pDesTimeBase = Coord[2].DesTimeBase.a

	abs
	tm(move_time/4) ta(0) ts(0)

	linear
	X(-rad/2) Y(rad)
	dwell 0

	while(gWs_LaserEna==0){}

	EncTable[esM].ScaleFactor=1/(256*(EncTable[esM].index5+1)*(Coord[1].Tm*-1))
	Coord[2].pDesTimeBase = EncTable[esM].DeltaPos.a
	
	while(gWs_LaserEna==1 && Coord[1].ProgRunning==1)
	{
		X(rad/2) Y(rad)
		X(-rad/2) Y(-rad)
		X(rad/2) Y(-rad)
		X(-rad/2) Y(rad)
		gWs_WblCnt++
	}
close
