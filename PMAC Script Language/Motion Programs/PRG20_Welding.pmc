open prog 20
	abs
	linear
	f(150) ta(0.1) ts(0)
	frax(c, x, y)

	//Laser & wobble off ///////////////////////
	M11 P0 //Laser off
	DWELL 0
	M21 // wobble off

	//Move to start pos. And Speed ///////////////////////
	//f(150) // Pos-init speed
	x-11.998		y11.998		c(0.000) // start pos
	dwell 0

	gWs_RefVel = 40
	f(gWs_RefVel) ta(0.1) ts(0)
	//Core Laswr ///////////////////////
	M12 W0//core power

	//Ring Laswr ///////////////////////
	M14 W0//ring power

	//Wobble ///////////////////////
	M21// wobble off
	M20 A100 B100 D100 L500 T0 // wabble setting

	//Velocity ///////////////////////
	M101 V40
	//Modulation ///////////////////////
	//M140 O0 P1 // On Time [ms], Period [um]
	M10 P100		// Laser On

	frax(x, y)
sg
	gWs_File_Prog_TimeBuf = Sys.Time;
