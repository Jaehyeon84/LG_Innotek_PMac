

open subprog spAbortWsLoop
	gWs_Load_Abort = 1;			// Abort Load Sequence
	gWs_Ready_Abort = 1;		// Abort Ready Sequence
	gWs_Welding_Abort = 1;		// Abort Welding Sequence
	gWs_Wait_Abort = 1;			// Abort Wait Sequence
	gWs_Unload_Abort = 1;		// Abort Unload Sequence
	gWs_Reject_Abort = 1;		// Abort Reject Sequence

	if(gWs_Loop_Sta!=cSeqSta_Err)	gWs_Loop_Sta = cSeqSta_Idl;		// Clear Sequence Status Except Error
	gWs_Loop_Seq = 0;			// Clear Sequence Number
	gWs_Loop_Ena = 0;			// Disable Sequence
close
