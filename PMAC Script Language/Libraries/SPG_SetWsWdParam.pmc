

open subprog spSetWsWdParam(&ret)
	if(pUmem_Cmd_Ws_WdVelX <= 0)		// X Velocity Config Error
	{
		ret = -1;
		return
	}
	else if(pUmem_Cmd_Ws_WdVelY <= 0)	// Y Velocity Config Error
	{
		ret = -2;
		return
	}
	else if(pUmem_Cmd_Ws_WdVelC <= 0)	// C Velocity Config Error
	{
		ret = -3;
		return
	}

	// Set Motor Speed
	gWs_Welding_VelX = pUmem_Cmd_Ws_WdVelX/1000;
	gWs_Welding_VelY = pUmem_Cmd_Ws_WdVelY/1000;
	gWs_Welding_VelC = pUmem_Cmd_Ws_WdVelC/1000;

	// Set Motor Target Position
	gWs_Welding_PosX = pUmem_Cmd_Ws_WdPosX;
	gWs_Welding_PosY = pUmem_Cmd_Ws_WdPosY;
	gWs_Welding_PosC = pUmem_Cmd_Ws_WdPosC;
	//--------------------------------------------------------//
	if(pUmem_Cmd_Ws_AccLimitX <= 0)		// X Acceleration Limit Config Error
	{
		ret = -10;
		return
	}
	if(pUmem_Cmd_Ws_AccLimitY <= 0)		// Y Acceleration Limit Config Error
	{
		ret = -11;
		return
	}
	if(pUmem_Cmd_Ws_AccLimitC <= 0)		// C Acceleration Limit Config Error
	{
		ret = -12;
		return
	}
	if(pUmem_Cmd_Ws_VelLimitC <= 0)		// C Velocity Limit Config Error
	{
		ret = -13;
		return
	}

	// Set Motor Acceleration Limit
	gWs_AccLimitX	= pUmem_Cmd_Ws_AccLimitX; 
	gWs_AccLimitY	= pUmem_Cmd_Ws_AccLimitY;
	gWs_AccLimitC	= pUmem_Cmd_Ws_AccLimitC; 
	gWs_VelLimitC	= pUmem_Cmd_Ws_VelLimitC;

	Motor[nwX].InvAmax = 1/gWs_AccLimitX;
	Motor[nwX].InvDmax = 1/gWs_AccLimitX;
	Motor[nwY].InvAmax = 1/gWs_AccLimitY;
	Motor[nwY].InvDmax = 1/gWs_AccLimitY;
	Motor[nwC].InvAmax = 1/gWs_AccLimitC;
	Motor[nwC].InvDmax = 1/gWs_AccLimitC;
	
	// Set Motor C Velocity Limit
	Coord[1].AltFeedRate = gWs_VelLimitC;
	//--------------------------------------------------------//
	if(pUmem_Cmd_Ws_RefVel <= 0)		// Vector Velocity Config Error
	{
		ret = -20;
		return
	}
	if(pUmem_Cmd_Ws_CorePfmEna==1 || pUmem_Cmd_Ws_RingPfmEna==1)
	{
		if(pUmem_Cmd_Ws_PfmPeriod <= 0)		// Pfm Period Config Error
		{
			ret = -21;
			return
		}
		if(pUmem_Cmd_Ws_PfmOnTime <= 0)		// Pfm On Distance Config Error
		{
			ret = -22;
			return
		}
	}
	gWs_OutMode			= pUmem_Cmd_Ws_OutMode;			// Set Output Mode
	gWs_RefVel			= pUmem_Cmd_Ws_RefVel;			// Set Vector Velocity

	gWs_OutMode_2		= pUmem_Cmd_Ws_OutMode_2;			// Set Output Mode
	gWs_RefVel_2		= pUmem_Cmd_Ws_RefVel_2;			// Set Vector Velocity

	// Set Core Laser Parameters
	gWs_CorePowSf		= pUmem_Cmd_Ws_CorePowerSf;
	gWs_CoreRefPow		= pUmem_Cmd_Ws_CoreRefPower;
	gWs_CoreMinPow		= pUmem_Cmd_Ws_CoreMinPower;
	gWs_CoreMaxPow		= pUmem_Cmd_Ws_CoreMaxPower;

	gWs_CoreRefPow_2	= pUmem_Cmd_Ws_CoreRefPower_2;

	// Set Ring Laser Parameters
	gWs_RingPowSf		= pUmem_Cmd_Ws_RingPowerSf;
	gWs_RingRefPow		= pUmem_Cmd_Ws_RingRefPower;
	gWs_RingMinPow		= pUmem_Cmd_Ws_RingMinPower;
	gWs_RingMaxPow		= pUmem_Cmd_Ws_RingMaxPower;

	gWs_RingRefPow_2	= pUmem_Cmd_Ws_RingRefPower_2;

	// Set Laser Pfm Parameters
	gWs_CorePfmEna		= pUmem_Cmd_Ws_CorePfmEna;
	gWs_RingPfmEna		= pUmem_Cmd_Ws_RingPfmEna;
	gWs_PfmPeriod		= pUmem_Cmd_Ws_PfmPeriod;
	gWs_PfmOnTime		= pUmem_Cmd_Ws_PfmOnTime;

	// Set Laser Pfm Parameters
	gWs_CorePfmEna_2	= pUmem_Cmd_Ws_CorePfmEna_2;
	gWs_RingPfmEna_2	= pUmem_Cmd_Ws_RingPfmEna_2;
	gWs_PfmPeriod_2		= pUmem_Cmd_Ws_PfmPeriod_2;
	gWs_PfmOnTime_2		= pUmem_Cmd_Ws_PfmOnTime_2;


	//--------------------------------------------------------//
	if(pUmem_Cmd_Sc_WblEna==1)
	{
		if(pUmem_Cmd_Sc_WblLen <= 0)		// Wobble Length Config Error
		{
			ret = -30;
			return
		}
		if(pUmem_Cmd_Sc_WblDist <= 0)		// Wobble Distance Config Error
		{
			ret = -31;
			return
		}
	}

	if(pUmem_Cmd_Sc_WblEna_2==1)
	{
		if(pUmem_Cmd_Sc_WblLen_2 <= 0)		// Wobble Length Config Error
		{
			ret = -30;
			return
		}
		if(pUmem_Cmd_Sc_WblDist_2 <= 0)		// Wobble Distance Config Error
		{
			ret = -31;
			return
		}
	}

	// Set Wobble Pfm Parameters
	gWs_WblEna			= pUmem_Cmd_Sc_WblEna;
	gWs_WblLen			= pUmem_Cmd_Sc_WblLen;
	gWs_WblDst			= pUmem_Cmd_Sc_WblDist;
	gWs_WblType			= pUmem_Cmd_Sc_WblType;
	gWs_WblRatW			= pUmem_Cmd_Sc_WblRatioW;
	gWs_WblRatL			= pUmem_Cmd_Sc_WblRatioL;
	gWs_WblOfsX			= pUmem_Cmd_Sc_WblOffsetX;
	gWs_WblOfsY			= pUmem_Cmd_Sc_WblOffsetY;

	gWs_WblEna_2		= pUmem_Cmd_Sc_WblEna_2;
	gWs_WblLen_2		= pUmem_Cmd_Sc_WblLen_2;
	gWs_WblDst_2		= pUmem_Cmd_Sc_WblDist_2;
	gWs_WblType_2		= pUmem_Cmd_Sc_WblType_2;
	gWs_WblRatW_2		= pUmem_Cmd_Sc_WblRatioW_2;
	gWs_WblRatL_2		= pUmem_Cmd_Sc_WblRatioL_2;
	gWs_WblOfsX_2		= pUmem_Cmd_Sc_WblOffsetX_2;
	gWs_WblOfsY_2		= pUmem_Cmd_Sc_WblOffsetY_2;

	ret = 0;
close



