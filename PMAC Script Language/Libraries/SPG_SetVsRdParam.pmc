

open subprog spSetVsRdParam(&ret)
	if(pUmem_Cmd_Vs_RdVelX <= 0)		// X Velocity Config Error
	{
		ret = -1;
		return
	}
	else if(pUmem_Cmd_Vs_RdVelY <= 0)	// Y Velocity Config Error
	{
		ret = -2;
		return
	}
	else if(pUmem_Cmd_Vs_RdVelC <= 0)	// C Velocity Config Error
	{
		ret = -3;
		return
	}

	// Set Motor Speed
	gVs_Ready_VelX = pUmem_Cmd_Vs_RdVelX/1000;
	gVs_Ready_VelY = pUmem_Cmd_Vs_RdVelY/1000;
	gVs_Ready_VelC = pUmem_Cmd_Vs_RdVelC/1000;

	// Set Motor Target Position
	gVs_Ready_PosX = pUmem_Cmd_Vs_RdPosX;
	gVs_Ready_PosY = pUmem_Cmd_Vs_RdPosY;
	gVs_Ready_PosC = pUmem_Cmd_Vs_RdPosC;

	ret = 0;
close



