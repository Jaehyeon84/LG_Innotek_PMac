	Motor[inc_idx].ProgJogPos = (Motor[inc_idx].DesPos - Motor[inc_idx].HomePos) + lVsout_pos;
	Motor[inc_idx].InPosBand = cMotor_InPosBand_Point;
	Motor[inc_idx].JogSpeed = cMotor_ThCoverPosMoveSpeed;

	out_pos = rint(((Motor[inc_idx].DesPos - Motor[inc_idx].HomePos) + lVsout_pos) % 360000);
	//out_pos = inc_pos;

	if(out_pos < 0)
		out_pos += 360000;

	Ldata.motor = inc_idx;
	jog=*
close
