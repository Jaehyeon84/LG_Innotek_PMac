	lVsPosCBuf = pUmem_Sta_CmdPos(inc_idx);

	if(lVsPosCBuf < 0)
		lVsPosCBuf += 360000;

	lVsTargetPos = inc_pos % 360000;

	if(lVsTargetPos < 0)
		lVsTargetPos += 360000;

	lVsout_pos = lVsTargetPos - lVsPosCBuf;

	if(lVsout_pos > 180000)
		lVsout_pos -= 360000;
	else if(lVsout_pos <= -180000)
		lVsout_pos += 360000;

	//gVs_ThPos_Old = Motor[inc_idx].ProgJogPos;
	//Motor[inc_idx].ProgJogPos = pUmem_Sta_CmdPos(inc_idx) + lVsout_pos;
	Motor[inc_idx].ProgJogPos = lVsout_pos;
	out_pos = rint(((Motor[inc_idx].DesPos - Motor[inc_idx].HomePos) + lVsout_pos) % 360000);
	//out_pos = inc_pos;

close
